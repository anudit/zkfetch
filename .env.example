# Copy to .env (git-ignored). Bun loads it automatically.

# Duolingo private auth token: the value of the `jwt_token` cookie on
# duolingo.com (DevTools > Application > Cookies). Used as `Authorization: Bearer`.
# It never leaves the MPC session in plaintext and is redacted in presentations.
DUOLINGO_JWT=
DUOLINGO_USERNAME=anudit
# Optional; resolved from the username when empty.
DUOLINGO_USER_ID=

# Optional; a local notary is started when empty.
ZKF_NOTARY_URL=
# Public key from your deployment manifest; required for a trusted remote benchmark.
ZKF_NOTARY_PUBLIC_KEY=
ZKF_TLS_VERSION=auto
# mpc (default) or proxy.
ZKF_MODE=
# 1 (default): commit only what the presentation discloses; 0: commit everything.
ZKF_REVEAL=1
# The playground averages three runs each with QuickSilver and Binius.
# Optional hidden-value proof; requires DUOLINGO_JWT. Omit to disclose streak.
ZKF_STREAK_MINIMUM=
# Optional benchmark matrix: TLS 1.3 and TLS 1.2, three runs per backend per version.
PLAYGROUND_TLS_MATRIX=0
# Optional destination for JSON measurements (contains no session secrets).
PLAYGROUND_RESULTS=
